<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunar_scout_navigation</name>
  <version>1.0.0</version>
  <description>
    Navigation package for the Lunar PSR Autonomy Scout rover.
    Implements energy-aware path planning with A* algorithm, terrain traversability
    analysis, slope enforcement, waypoint queue management, hazard avoidance,
    and dead reckoning fallback during communications blackout.
    Integrates with Nav2 stack for autonomous navigation.
  </description>

  <maintainer email="rover-team@nasa-jpl.example.gov">Lunar Scout Team</maintainer>
  <license>NASA Open Source Agreement 1.3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_simple_commander</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
