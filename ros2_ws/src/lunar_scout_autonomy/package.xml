<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunar_scout_autonomy</name>
  <version>1.0.0</version>
  <description>
    Autonomy manager for the Lunar PSR Autonomy Scout rover.
    Implements a lifecycle-managed state machine with BehaviorTree integration,
    mission timeline execution, watchdog monitoring, and fault-triggered safe modes.
    Designed to operate with Earth communication delays of 1.3 seconds one-way.
  </description>

  <maintainer email="rover-team@nasa-jpl.example.gov">Lunar Scout Team</maintainer>
  <license>NASA Open Source Agreement 1.3</license>
  <author email="rover-team@nasa-jpl.example.gov">Lunar Scout Engineering Team</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>action_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rcl_interfaces</depend>

  <!-- Custom interfaces (defined in this package) -->
  <depend>rosidl_default_generators</depend>
  <depend>rosidl_default_runtime</depend>
  <depend>action_msgs</depend>

  <exec_depend>python3-py-trees</exec_depend>
  <exec_depend>python3-transitions</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
