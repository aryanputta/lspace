<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunar_scout_power_management</name>
  <version>1.0.0</version>
  <description>
    Power management node for the Lunar PSR Autonomy Scout rover.
    Tracks solar input, battery state of charge with temperature derating,
    implements load shedding priority tables, eclipse survival mode,
    and battery thermal heater control.
    Solar: 200W peak, Battery: 150Wh Li-Ion pack.
  </description>

  <maintainer email="rover-team@nasa-jpl.example.gov">Lunar Scout Team</maintainer>
  <license>NASA Open Source Agreement 1.3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
