<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunar_scout_wheel_control</name>
  <version>1.0.0</version>
  <description>
    LPAS wheel control node — rocker-bogie kinematics, traction control,
    slip prediction integration, and wheel odometry.
  </description>
  <maintainer email="lpas-sw@example.com">LPAS Software Team</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
