<!-- LPAS heritage models for Gazebo reference display -->

  <model name="heritage_chassis_body">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://lpas_rover/meshes/chassis_body.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>

