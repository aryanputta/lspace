<?xml version="1.0" ?>
<!--
  Lunar South Pole Simulation World - Gazebo Fortress (Gazebo 6)
  =============================================================
  Physics:    ODE solver, lunar gravity (-1.62 m/s²)
  Terrain:    LOLA DEM heightmap, 512x512, 50m/pixel → 25.6 km × 25.6 km
  Lighting:   Sun at 2° above horizon (azimuth 180°), long-shadow regime
  Ambient:    0.05 (dark PSR boundary region)
  Atmosphere: None (vacuum)
  Features:   Boulders, craters, comms relay station
-->
<sdf version="1.9">
  <world name="lunar_south_pole">

    <!-- ================================================================
         PHYSICS
         ================================================================ -->
    <physics name="lunar_ode" type="ode" default="true">
      <!-- Lunar surface gravity: 1.62 m/s² downward -->
      <gravity>0 0 -1.62</gravity>

      <!-- Real-time factor: 1.0 for hardware-in-the-loop testing -->
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>

      <ode>
        <solver>
          <!-- Quickstep with high iterations for stable regolith contact -->
          <type>quick</type>
          <iters>200</iters>
          <precon_iters>0</precon_iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <!-- Tight tolerances for rover wheel contact accuracy -->
          <cfm>1e-5</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================================================================
         SCENE / LIGHTING
         Sun at 2° elevation above the horizon, azimuth 180° (south),
         simulating the permanent low-sun condition at the lunar south pole.
         Direction vector: sun azimuth 180°, elevation 2°
           x = cos(2°)·sin(180°) ≈  0.0
           y = cos(2°)·cos(180°) ≈ -0.9994
           z = sin(2°)            ≈  0.0349   (pointing upward from ground)
         Gazebo direction is TO the light, so negate:
           direction: 0  0.9994  -0.0349
         ================================================================ -->
    <scene>
      <ambient>0.05 0.05 0.05 1</ambient>
      <background>0.0 0.0 0.0 1</background>  <!-- black sky (no atmosphere) -->
      <sky>
        <clouds>
          <speed>0</speed>
        </clouds>
      </sky>
      <!-- Shadows disabled: WSL2 Mesa D3D12 lacks GL3PlusTextureGpu::copyTo -->
      <shadows>false</shadows>
      <fog>
        <!-- No fog - vacuum environment -->
        <type>none</type>
      </fog>
    </scene>

    <!-- Directional sun light - low-angle, casting very long shadows -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <!-- Direction vector pointing toward the light source -->
      <direction>0.0 0.9994 -0.0349</direction>
      <!-- Slightly warm sunlight (no atmospheric scattering, raw solar) -->
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.5 0.5 0.4 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Weak fill light simulating Earthshine / instrument self-illumination -->
    <light name="earthshine" type="directional">
      <cast_shadows>false</cast_shadows>
      <direction>0 0 -1</direction>
      <diffuse>0.01 0.01 0.02 1</diffuse>
      <specular>0 0 0 1</specular>
    </light>

    <!-- Gravity (-1.62 m/s²) and regolith friction are set directly in
         <physics> and terrain <surface> blocks above — no custom plugins needed. -->

    <!-- ================================================================
         TERRAIN HEIGHTMAP
         Source: LOLA DEM processed to 512×512 16-bit PNG
         Size:   25600 m × 25600 m (50 m/pixel)
         Height: encoded 0–65535 → -3000 m to +3000 m (6000 m total range)
         ================================================================ -->
    <model name="terrain">
      <static>true</static>
      <link name="terrain_link">
        <!-- Flat regolith plane — replaces DEM heightmap until a properly
             formatted 16-bit grayscale PNG is generated via process_dem_to_gazebo.py.
             The DEM PNG was triggering Image.cc:478 "Coordinates out of range" spam. -->
        <collision name="terrain_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Regolith friction coefficients (Heiken 1991, Carrier 1991) -->
                <mu>0.7</mu>
                <mu2>0.65</mu2>
                <fdir1>1 0 0</fdir1>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
              <bullet>
                <friction>0.7</friction>
                <friction2>0.65</friction2>
                <rolling_friction>0.05</rolling_friction>
              </bullet>
            </friction>
            <bounce>
              <restitution_coefficient>0.01</restitution_coefficient>
              <threshold>100000</threshold>
            </bounce>
            <contact>
              <ode>
                <soft_cfm>1e-5</soft_cfm>
                <soft_erp>0.15</soft_erp>
                <kp>1e6</kp>
                <kd>100</kd>
                <max_vel>0.1</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <!-- Lunar regolith albedo ~0.12 (Apollo measurements) -->
            <ambient>0.10 0.09 0.08 1</ambient>
            <diffuse>0.14 0.13 0.11 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BOULDERS - scattered realistically across terrain
         Positions and orientations chosen to match expected LROC-observed
         boulder density (~2-5 per km² at > 1m diameter near craters)
         ================================================================ -->

    <!-- Boulder cluster near Shackleton rim (NE quadrant) -->
    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_001</name>
      <pose>1250.0 800.0 0 0.0 0.0 0.523</pose>
    </include>

    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_002</name>
      <pose>1280.0 830.0 0 0.12 0.0 1.047</pose>
      <scale>0.6 0.6 0.6</scale>
    </include>

    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_003</name>
      <pose>1220.0 790.0 0 0.0 0.08 2.094</pose>
      <scale>1.4 1.4 1.4</scale>
    </include>

    <!-- Isolated boulder - traverse path obstacle -->
    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_004</name>
      <pose>-340.0 1100.0 0 0.05 0.0 0.785</pose>
      <scale>0.8 0.8 0.8</scale>
    </include>

    <!-- Boulder cluster near crater_alpha -->
    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_005</name>
      <pose>-800.0 -450.0 0 0.0 0.15 1.309</pose>
    </include>

    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_006</name>
      <pose>-820.0 -480.0 0 0.1 0.0 0.0</pose>
      <scale>1.8 1.8 1.8</scale>
    </include>

    <!-- Scattered boulders - SW quadrant -->
    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_007</name>
      <pose>-1500.0 -200.0 0 0.0 0.0 3.665</pose>
      <scale>0.5 0.5 0.5</scale>
    </include>

    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_008</name>
      <pose>-1550.0 -230.0 0 0.07 0.12 2.356</pose>
    </include>

    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_009</name>
      <pose>600.0 -1200.0 0 0.0 0.0 1.571</pose>
      <scale>2.0 2.0 2.0</scale>
    </include>

    <include>
      <uri>model://lunar_boulder</uri>
      <name>boulder_010</name>
      <pose>620.0 -1180.0 0 0.15 0.0 0.262</pose>
      <scale>0.7 0.7 0.7</scale>
    </include>

    <!-- ================================================================
         CRATERS
         Three impact craters with realistic geometry
         (simple bowl shapes approximated with scaled cylinders + heightmap)
         ================================================================ -->

    <!-- Crater Alpha: ~80m diameter, 12m deep, SE quadrant -->
    <model name="crater_alpha">
      <static>true</static>
      <pose>-900.0 -600.0 -6.0 0 0 0</pose>
      <link name="crater_link">
        <collision name="crater_rim">
          <geometry>
            <cylinder>
              <radius>40.0</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.75</mu><mu2>0.70</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="crater_visual">
          <geometry>
            <cylinder>
              <radius>40.0</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.11 0.10 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crater Beta: ~200m diameter, PSR candidate, NW quadrant -->
    <model name="crater_beta">
      <static>true</static>
      <pose>-1800.0 1400.0 -18.0 0 0 0</pose>
      <link name="crater_link">
        <collision name="crater_rim">
          <geometry>
            <cylinder>
              <radius>100.0</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Ice-contaminated regolith in PSR -->
                <mu>0.5</mu>
                <mu2>0.45</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="crater_visual">
          <geometry>
            <cylinder>
              <radius>100.0</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.04 0.04 0.05 1</ambient>
            <diffuse>0.06 0.06 0.08 1</diffuse>
            <specular>0.02 0.02 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crater Gamma: ~50m diameter, fresh impact, NE quadrant -->
    <model name="crater_gamma">
      <static>true</static>
      <pose>2000.0 1800.0 -4.0 0 0 0</pose>
      <link name="crater_link">
        <collision name="crater_rim">
          <geometry>
            <cylinder>
              <radius>25.0</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="crater_visual">
          <geometry>
            <cylinder>
              <radius>25.0</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <!-- Fresh ejecta - slightly brighter -->
            <ambient>0.12 0.11 0.10 1</ambient>
            <diffuse>0.18 0.16 0.14 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         COMMUNICATION RELAY STATION
         Fixed position on a topographic high for maximum LOS coverage
         Position: +3200 m East, -800 m North (sunlit ridge)
         ================================================================ -->
    <include>
      <uri>model://comms_relay_station</uri>
      <name>comms_relay_primary</name>
      <pose>3200.0 -800.0 0 0 0 0</pose>
    </include>

    <!-- ================================================================
         ATMOSPHERIC / ENVIRONMENTAL SETTINGS
         Vacuum conditions: no wind, no atmosphere
         ================================================================ -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>

    <!-- ================================================================
         MISSION SPAWN AREA
         Nominal rover deployment zone near station
         ================================================================ -->
    <model name="spawn_marker">
      <static>true</static>
      <pose>3100.0 -790.0 0.01 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry>
            <cylinder>
              <radius>2.0</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.0 0.5</ambient>
            <diffuse>0.0 1.0 0.0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         GUI CAMERA - positioned for overview of terrain
         ================================================================ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-200 -5000 3000 0 0.8 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
