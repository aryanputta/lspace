<?xml version="1.0" ?>
<model>
  <name>comms_relay_station</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>NASA Lunar Scout Simulation Team</name>
    <email>sim@lunarscout.nasa.gov</email>
  </author>

  <description>
    Lunar surface communication relay station for south pole rover missions.
    Fixed-base structure with 4m mast, 1.2m HGA dish (X-band, Earth-pointing),
    UHF omnidirectional LGA for rover proximity, dual deployable solar panels,
    electronics box with MLI/radiator, and operational status LEDs.
    Total mass: ~85 kg. Base footprint: 1.5m x 1.5m. Height: 5.2m.
  </description>
</model>
