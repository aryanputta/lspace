<?xml version="1.0" ?>
<model>
  <name>lunar_boulder</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>NASA Lunar Scout Simulation Team</name>
    <email>sim@lunarscout.nasa.gov</email>
  </author>

  <description>
    Lunar basalt boulder for the south pole simulation environment.
    Represents a 1.2m nominal diameter boulder with regolith-coated basalt
    physical properties. Collision geometry uses multi-box convex hull
    approximation. Mass: ~2170 kg (density 3100 kg/m3). Friction mu=0.7.
  </description>
</model>
