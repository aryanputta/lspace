<?xml version="1.0" ?>
<!--
  Permanently Shadowed Region (PSR) Interior Simulation - Gazebo Fortress (Gazebo 6)
  ==================================================================================
  Models the interior of a lunar PSR crater (e.g., Haworth, Shoemaker, or Nobile).

  Environmental parameters:
    Temperature:   ~40 K (permanent shadow, never direct sunlight)
    Ambient light: ~0.001 (only scattered Earthshine + instrument lighting)
    Terrain:       Ice-contaminated regolith, rough floor, steep walls
    Obstacles:     Dense field of ice/rock blocks, narrow traversable corridors
    Comms:         Deep shadow zone - LOS to relay station blocked by crater rim

  Reference: Hayne et al. (2015), Nature Geoscience - PSR characterization
             Colaprete et al. (2010), Science - LCROSS water ice detection
-->
<sdf version="1.9">
  <world name="psr_interior">

    <!-- ================================================================
         PHYSICS - Same lunar gravity, tighter tolerances for ice contact
         ================================================================ -->
    <physics name="psr_ode" type="ode" default="true">
      <gravity>0 0 -1.62</gravity>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <ode>
        <solver>
          <!-- Higher iterations for ice+regolith mixed contacts -->
          <type>quick</type>
          <iters>300</iters>
          <precon_iters>0</precon_iters>
          <sor>1.2</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>5e-6</cfm>
          <erp>0.15</erp>
          <contact_max_correcting_vel>50</contact_max_correcting_vel>
          <!-- Thin contact layer for ice surface -->
          <contact_surface_layer>0.0005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================================================================
         SCENE / LIGHTING
         PSR interior: effectively zero direct sunlight.
         Only source: Earthshine (~0.0006 lux equivalent) and
         any rover/instrument lighting (handled separately).
         ambient = 0.001 simulates absolute darkness at sensor level.
         ================================================================ -->
    <scene>
      <!-- Near-total darkness: PSR floor receives no direct solar radiation -->
      <ambient>0.001 0.001 0.002 1</ambient>
      <!-- Black sky - crater walls block most of the sky -->
      <background>0.0 0.0 0.0 1</background>
      <sky>
        <clouds><speed>0</speed></clouds>
      </sky>
      <shadows>true</shadows>
      <fog>
        <type>none</type>
      </fog>
    </scene>

    <!-- ================================================================
         MINIMAL EARTHSHINE FILL LIGHT
         Earth subtends ~2° from Moon, albedo ~0.3
         Effective illuminance in PSR: ~0.002 lux (barely measurable)
         Represented as extremely dim directional light from above
         ================================================================ -->
    <light name="earthshine_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <direction>0.05 0.1 -1</direction>
      <!-- Slight blue tint of Earthshine (reflected atmosphere) -->
      <diffuse>0.002 0.002 0.003 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
    </light>

    <!-- Dim ambient point light simulating rover headlights (for visual debug) -->
    <!-- In real mission, rover carries its own lighting; this is scene ambient only -->
    <light name="rover_area_light" type="point">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 0.5 0 0 0</pose>
      <diffuse>0.015 0.012 0.010 1</diffuse>
      <specular>0.005 0.004 0.003 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <!-- ================================================================
         PLUGINS
         ================================================================ -->
    <plugin filename="liblunargravity_plugin.so" name="lunar_gravity_plugin">
      <gravity_z>-1.62</gravity_z>
    </plugin>

    <plugin filename="libregolith_terrain_plugin.so" name="psr_terrain_plugin">
      <!-- Ice-contaminated regolith parameters -->
      <cohesion_kPa>0.08</cohesion_kPa>        <!-- lower cohesion: ice weakens bonds -->
      <friction_angle_deg>28.0</friction_angle_deg>  <!-- lower angle for icy surface -->
      <deformation_exponent>1.3</deformation_exponent>
      <sinkage_modulus_kPa>3.0</sinkage_modulus_kPa>
      <static_friction>0.45</static_friction>   <!-- reduced: ice contamination -->
      <dynamic_friction>0.35</dynamic_friction>
      <!-- PSR-specific metadata (read by temperature/thermal plugins) -->
      <surface_temperature_K>40.0</surface_temperature_K>
      <ice_fraction>0.085</ice_fraction>        <!-- 8.5% water ice by mass (LCROSS est.) -->
      <regolith_type>psr_icy</regolith_type>
    </plugin>

    <!-- Temperature metadata plugin - records thermal state for thermal model -->
    <plugin filename="libpsr_temperature_plugin.so" name="psr_temperature_plugin">
      <ambient_temperature_K>40.0</ambient_temperature_K>
      <surface_temperature_K>40.0</surface_temperature_K>
      <!-- PSR never exceeds ~100K even at crater rim shadow boundary -->
      <max_temperature_K>100.0</max_temperature_K>
      <thermal_inertia>50.0</thermal_inertia>   <!-- tiu, typical PSR value -->
    </plugin>

    <!-- ================================================================
         PSR FLOOR TERRAIN
         Represents the flat, ice-dusted crater floor
         Dimensions: 500m x 500m (small PSR interior section)
         Height range: -50m to 0m (crater depth above datum)
         ================================================================ -->
    <model name="psr_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>500 500 1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Ice-contaminated regolith: significantly reduced friction -->
                <mu>0.45</mu>
                <mu2>0.40</mu2>
                <fdir1>1 0 0</fdir1>
                <slip1>0.002</slip1>
                <slip2>0.002</slip2>
              </ode>
              <bullet>
                <friction>0.45</friction>
                <friction2>0.40</friction2>
                <rolling_friction>0.03</rolling_friction>
              </bullet>
            </friction>
            <bounce>
              <restitution_coefficient>0.02</restitution_coefficient>
              <threshold>100000</threshold>
            </bounce>
            <contact>
              <ode>
                <soft_cfm>2e-5</soft_cfm>
                <soft_erp>0.1</soft_erp>
                <kp>8e5</kp>   <!-- softer than dry regolith -->
                <kd>80</kd>
                <max_vel>0.05</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>500 500 1</size>
            </box>
          </geometry>
          <material>
            <!-- Dark ice-contaminated regolith: very low albedo ~0.06-0.10 -->
            <ambient>0.06 0.06 0.07 1</ambient>
            <diffuse>0.08 0.08 0.10 1</diffuse>
            <specular>0.04 0.04 0.06 1</specular>   <!-- slight specular: frost patches -->
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
      </link>
    </model>

    <!-- ================================================================
         CRATER WALLS (N, S, E, W) - steep slopes blocking horizon
         Average PSR crater wall slope: 25-35°
         ================================================================ -->
    <model name="crater_wall_north">
      <static>true</static>
      <pose>0 250 35 -0.6109 0 0</pose>  <!-- 35° tilt inward -->
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>520 10 80</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.75</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>520 10 80</size></box>
          </geometry>
          <material>
            <ambient>0.09 0.08 0.07 1</ambient>
            <diffuse>0.14 0.12 0.10 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crater_wall_south">
      <static>true</static>
      <pose>0 -250 35 0.6109 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>520 10 80</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.75</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>520 10 80</size></box>
          </geometry>
          <material>
            <ambient>0.09 0.08 0.07 1</ambient>
            <diffuse>0.14 0.12 0.10 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crater_wall_east">
      <static>true</static>
      <pose>250 0 35 0 0.6109 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>10 520 80</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.75</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>10 520 80</size></box>
          </geometry>
          <material>
            <ambient>0.09 0.08 0.07 1</ambient>
            <diffuse>0.14 0.12 0.10 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crater_wall_west">
      <static>true</static>
      <pose>-250 0 35 0 -0.6109 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>10 520 80</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.75</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>10 520 80</size></box>
          </geometry>
          <material>
            <ambient>0.09 0.08 0.07 1</ambient>
            <diffuse>0.14 0.12 0.10 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         DENSE OBSTACLE FIELD - ice/rock blocks across PSR floor
         Designed to require careful path planning with narrow corridors.
         Ice blocks: angular, irregularly placed, partially buried in regolith.
         Grid-ish pattern but with gaps forming traversable corridors.
         ================================================================ -->

    <!-- Corridor 1: Main east-west traverse path (y ≈ 0, gaps at x=±50,±100,±150) -->

    <!-- Row 1: y = -60 to -40 (obstacle row south of corridor) -->
    <model name="ice_block_s01">
      <static>true</static>
      <pose>-120 -50 0.4 0.1 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.5 2.0 0.8</size></box></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.38</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>2.5 2.0 0.8</size></box></geometry>
          <material><ambient>0.4 0.45 0.5 1</ambient><diffuse>0.5 0.55 0.65 1</diffuse><specular>0.3 0.35 0.4 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_s02">
      <static>true</static>
      <pose>-80 -55 0.6 0 0.15 1.1</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 1.5 1.2</size></box></geometry>
          <surface><friction><ode><mu>0.42</mu><mu2>0.40</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>3.0 1.5 1.2</size></box></geometry>
          <material><ambient>0.38 0.42 0.48 1</ambient><diffuse>0.48 0.52 0.60 1</diffuse><specular>0.28 0.32 0.38 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_s03">
      <static>true</static>
      <pose>-20 -48 0.3 0.05 0 0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 2.2 0.6</size></box></geometry>
          <surface><friction><ode><mu>0.41</mu><mu2>0.39</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>1.8 2.2 0.6</size></box></geometry>
          <material><ambient>0.42 0.46 0.52 1</ambient><diffuse>0.52 0.56 0.64 1</diffuse><specular>0.32 0.35 0.40 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_s04">
      <static>true</static>
      <pose>40 -52 0.5 0.12 0.08 2.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.8 2.0 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.43</mu><mu2>0.41</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>2.8 2.0 1.0</size></box></geometry>
          <material><ambient>0.40 0.44 0.50 1</ambient><diffuse>0.50 0.54 0.62 1</diffuse><specular>0.30 0.33 0.38 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_s05">
      <static>true</static>
      <pose>100 -46 0.4 0 0 1.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 1.8 0.8</size></box></geometry>
          <surface><friction><ode><mu>0.40</mu><mu2>0.38</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>2.0 1.8 0.8</size></box></geometry>
          <material><ambient>0.41 0.45 0.51 1</ambient><diffuse>0.51 0.55 0.63 1</diffuse><specular>0.29 0.33 0.39 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Row 2: y = +40 to +60 (obstacle row north of corridor) -->
    <model name="ice_block_n01">
      <static>true</static>
      <pose>-100 48 0.7 0.08 0 0.9</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.5 1.5 1.4</size></box></geometry>
          <surface><friction><ode><mu>0.41</mu><mu2>0.39</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>3.5 1.5 1.4</size></box></geometry>
          <material><ambient>0.43 0.47 0.53 1</ambient><diffuse>0.53 0.57 0.65 1</diffuse><specular>0.31 0.35 0.41 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_n02">
      <static>true</static>
      <pose>-60 55 0.5 0 0.1 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 3.0 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.44</mu><mu2>0.42</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>2.0 3.0 1.0</size></box></geometry>
          <material><ambient>0.44 0.48 0.54 1</ambient><diffuse>0.54 0.58 0.66 1</diffuse><specular>0.30 0.34 0.40 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_n03">
      <static>true</static>
      <pose>0 50 0.4 0.1 0.05 1.8</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.4 2.0 0.8</size></box></geometry>
          <surface><friction><ode><mu>0.40</mu><mu2>0.38</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>2.4 2.0 0.8</size></box></geometry>
          <material><ambient>0.45 0.49 0.55 1</ambient><diffuse>0.55 0.59 0.67 1</diffuse><specular>0.29 0.33 0.39 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_n04">
      <static>true</static>
      <pose>70 46 0.6 0 0 2.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 2.5 1.2</size></box></geometry>
          <surface><friction><ode><mu>0.43</mu><mu2>0.41</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>1.6 2.5 1.2</size></box></geometry>
          <material><ambient>0.42 0.46 0.52 1</ambient><diffuse>0.52 0.56 0.64 1</diffuse><specular>0.28 0.32 0.38 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Scattered obstacles across northern half of PSR -->
    <model name="ice_block_mid01">
      <static>true</static>
      <pose>-150 20 0.5 0.07 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.2 1.8 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.42</mu><mu2>0.40</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>2.2 1.8 1.0</size></box></geometry>
          <material><ambient>0.40 0.44 0.50 1</ambient><diffuse>0.50 0.54 0.62 1</diffuse><specular>0.30 0.34 0.40 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_mid02">
      <static>true</static>
      <pose>-30 -20 0.3 0 0.12 1.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 2.8 0.6</size></box></geometry>
          <surface><friction><ode><mu>0.41</mu><mu2>0.39</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>1.5 2.8 0.6</size></box></geometry>
          <material><ambient>0.44 0.48 0.54 1</ambient><diffuse>0.54 0.58 0.66 1</diffuse><specular>0.32 0.36 0.42 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_mid03">
      <static>true</static>
      <pose>80 -15 0.8 0.05 0.1 0.7</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 2.5 1.6</size></box></geometry>
          <surface><friction><ode><mu>0.43</mu><mu2>0.41</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>3.0 2.5 1.6</size></box></geometry>
          <material><ambient>0.46 0.50 0.56 1</ambient><diffuse>0.56 0.60 0.68 1</diffuse><specular>0.33 0.37 0.43 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="ice_block_mid04">
      <static>true</static>
      <pose>150 25 0.4 0 0 3.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 1.5 0.8</size></box></geometry>
          <surface><friction><ode><mu>0.40</mu><mu2>0.38</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>2.0 1.5 0.8</size></box></geometry>
          <material><ambient>0.41 0.45 0.51 1</ambient><diffuse>0.51 0.55 0.63 1</diffuse><specular>0.29 0.33 0.39 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         FROST/ICE SURFACE PATCHES
         Thin ice sheets on crater floor - visual only, low-friction geometry
         Represents water ice deposits identified by LCROSS/LRO
         ================================================================ -->
    <model name="frost_patch_01">
      <static>true</static>
      <pose>-80 10 0.005 0 0 0.4</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>15 12 0.01</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <!-- Near-ice friction: very low -->
                <mu>0.25</mu>
                <mu2>0.22</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>15 12 0.01</size></box></geometry>
          <material>
            <!-- Translucent ice appearance -->
            <ambient>0.7 0.75 0.85 0.6</ambient>
            <diffuse>0.8 0.85 0.95 0.6</diffuse>
            <specular>0.9 0.92 0.96 1</specular>
            <emissive>0.01 0.01 0.015 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="frost_patch_02">
      <static>true</static>
      <pose>60 -30 0.005 0 0 1.2</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 20 0.01</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.22</mu><mu2>0.20</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 20 0.01</size></box></geometry>
          <material>
            <ambient>0.68 0.73 0.83 0.55</ambient>
            <diffuse>0.78 0.83 0.93 0.55</diffuse>
            <specular>0.88 0.90 0.94 1</specular>
            <emissive>0.008 0.008 0.012 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="frost_patch_03">
      <static>true</static>
      <pose>-160 -60 0.005 0 0 2.1</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>25 18 0.01</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.20</mu><mu2>0.18</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>25 18 0.01</size></box></geometry>
          <material>
            <ambient>0.72 0.77 0.87 0.65</ambient>
            <diffuse>0.82 0.87 0.97 0.65</diffuse>
            <specular>0.92 0.94 0.98 1</specular>
            <emissive>0.012 0.012 0.018 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         COMMUNICATION SHADOW ZONE MARKERS
         Flat disc markers indicating regions with no LOS to relay station.
         These are visualization aids - not physical obstacles.
         All of PSR interior is a comms shadow zone in this world.
         ================================================================ -->
    <model name="comms_shadow_marker_center">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <cylinder><radius>200.0</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <!-- Semi-transparent red overlay: communication shadow zone -->
            <ambient>0.5 0.0 0.0 0.15</ambient>
            <diffuse>0.8 0.0 0.0 0.15</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Comms boundary marker ring at crater rim -->
    <model name="comms_boundary_ring">
      <static>true</static>
      <pose>0 0 65 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <cylinder><radius>252.0</radius><length>0.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.0 0.4</ambient>
            <diffuse>1.0 0.5 0.0 0.4</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         NARROW TRAVERSABLE CORRIDORS - annotated waypoints
         These mark the passable paths through the obstacle field.
         Gap at x=-50, y=0: corridor A (8m wide)
         Gap at x=+25, y=0: corridor B (12m wide)
         ================================================================ -->
    <model name="corridor_marker_A">
      <static>true</static>
      <pose>-50 0 0.015 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <cylinder><radius>4.0</radius><length>0.01</length></cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.6 0.0 0.3</ambient>
            <diffuse>0.0 0.8 0.0 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="corridor_marker_B">
      <static>true</static>
      <pose>25 0 0.015 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <cylinder><radius>6.0</radius><length>0.01</length></cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.6 0.0 0.3</ambient>
            <diffuse>0.0 0.8 0.0 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         GUI CAMERA - tight framing of PSR interior
         ================================================================ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -400 200 0 0.5 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
